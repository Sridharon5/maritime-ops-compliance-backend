PORT=4000
# Optional in local dev: if unset, the server uses LOCAL_MONGODB_URI or a default localhost URI.
# Required in production (e.g. Vercel + Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/maritime_ops_compliance
# Optional: override the default local URI when MONGODB_URI is not set (non-production only).
# LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/maritime_ops_compliance
SEED_DATABASE=false
